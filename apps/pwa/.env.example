# ---------------------------------------------------------------------------
# DP Fitness PWA environment
# Copy to `.env` (git-ignored) and adjust. Everything here is PUBLIC config:
# it is bundled into the client, so never put secrets in NUXT_PUBLIC_* vars.
# ---------------------------------------------------------------------------

# Serve every screen from the fixtures in `data/*.ts`.
# true  → mock data (default; works with no backend running)
# false → read from Firebase / NUXT_PUBLIC_API_BASE
NUXT_PUBLIC_USE_MOCK_DATA=true

# Backend origin, used only when NUXT_PUBLIC_USE_MOCK_DATA=false.
# If this is empty the app falls back to mock data and logs a warning.
NUXT_PUBLIC_API_BASE=

# Free-form label for the running environment (development | staging | production).
NUXT_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Firebase web config
#
# These are public by design: they identify the project, they do not authorise
# anything. What keeps the data safe is `firestore.rules` and
# `storage.rules`, never the secrecy of these values — so they belong in the
# client bundle and there is nothing to leak here.
#
# Find them in the Firebase console under Project settings → Your apps → Web.
# ---------------------------------------------------------------------------
NUXT_PUBLIC_FIREBASE_API_KEY=

# Where the sign-in handler is served from. The console gives you
# `<project>.firebaseapp.com`, which works for the Google popup and the email
# link. Set it to the domain the app itself is served from if you want the
# Google *redirect* fallback to survive Safari's ITP — that path is the one an
# installed iOS home-screen app has to use. See FIREBASE.md.
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Which Firestore database in the project. Leave empty for `(default)`, which
# is the one a project starts with. A second database (`staging`, say) is a
# separate database with its own documents AND ITS OWN RULES — deploying rules
# without `--database` publishes them to `(default)` only.
#
# Set this per environment, never from NODE_ENV: NODE_ENV is `production` for
# any built bundle, so a staging deploy keyed off it would write to production.
NUXT_PUBLIC_FIREBASE_DATABASE_ID=

# The bucket for this environment, e.g. `recomp-48b7b-staging.firebasestorage.app`.
# It lives in the block above (NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET) — set it there.

# ---------------------------------------------------------------------------
# Firebase Admin credential — NOT public
#
# Note the missing `PUBLIC`. Everything above is NUXT_PUBLIC_* and is compiled
# into the browser bundle on purpose; those values identify the project and
# authorise nothing. This one is the opposite: it is a private key that acts as
# the project owner and bypasses every security rule. Naming it
# NUXT_PUBLIC_FIREBASE_SERVICE_ACCOUNT would ship full admin access to the
# database to every visitor, and there is no revoking a key that has been in a
# JS bundle.
#
# Nothing the app runs needs this. It is read only by scripts in `scripts/`,
# which do the things the rules deliberately forbid a member from doing — the
# access-code backfill, for instance, writes fields no client-side rule allows.
#
#   Console → Project settings → Service accounts → Generate new private key
#   base64 -i service-account.json | tr -d '\n'
#
# Base64 rather than raw JSON because a PEM private key contains newlines, and
# a .env value cannot span lines. Paste the result as one unbroken line.
NUXT_FIREBASE_SERVICE_ACCOUNT=

# Alternative to the above: a path to the unencoded key file. Keep it outside
# the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
