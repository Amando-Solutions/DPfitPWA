# Copy to `.env` in this directory. Deploy reads it; nothing here is secret.
# Left unset, `firebase deploy` asks for the value and writes it to
# `.env.<project-id>` itself.

# The service account the landing site authenticates as when it calls
# `createAccessCode` — the `client_email` inside the key in apps/web's
# NUXT_FIREBASE_SERVICE_ACCOUNT. A token for any other account is refused.
REGISTRATION_SERVICE_ACCOUNT=

# The landing site's release route, one per deployment (so one per database),
# comma-separated. `releasePreorderCodes` calls each hourly to send the access
# codes held during a pre-order. Empty calls nothing.
#   https://<landing-site>/api/preorder/release
#
# It authenticates with PREORDER_RELEASE_SECRET, which is a secret and so not
# set here. Set it once, to the same value as NUXT_PREORDER_RELEASE_SECRET:
#   firebase functions:secrets:set PREORDER_RELEASE_SECRET
PREORDER_RELEASE_URLS=
SITE_URL=
