# Copy to `.env` in this directory. Deploy reads it; nothing here is secret.
# Left unset, `firebase deploy` asks for the value and writes it to
# `.env.<project-id>` itself.

# The service account the landing site authenticates as when it calls
# `createAccessCode` — the `client_email` inside the key in apps/web's
# NUXT_FIREBASE_SERVICE_ACCOUNT. A token for any other account is refused.
REGISTRATION_SERVICE_ACCOUNT=
