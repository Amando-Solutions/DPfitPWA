# Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Use `staging` for development. Leave `(default)` for production.
VITE_FIREBASE_DATABASE_ID=staging

# The shared callable function is deployed beside Firestore.
VITE_FIREBASE_FUNCTIONS_REGION=africa-south1

# Feature flags (off unless set to "true")
VITE_FEATURE_PROGRAM_REWARDS=false
