{
  "name": "dp-fitness-web",
  "private": true,
  "type": "module",
  "description": "DP Fitness \u00b7 Recomp Challenge, public landing site",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3001",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
