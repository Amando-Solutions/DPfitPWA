rules_version = '2';

// =============================================================================
// DP Fitness — Firestore security rules
//
// The app talks to Firestore directly from the browser, so these rules are the
// only thing standing between a member and everyone else's data. Read them as
// the real access-control policy, not as a formality.
//
// Two principles run through the whole file:
//
//   1. A member reads their own documents and writes their own documents.
//      Everything under `members/{uid}` is gated on `uid == request.auth.uid`,
//      with no exceptions, including for the coach — coach tooling belongs on
//      the Admin SDK, which bypasses rules entirely.
//
//   2. Anything shared with the cohort is a projection, never the source.
//      The leaderboard reads `cohorts/{id}/leaderboard`, which holds a name, an
//      avatar and a count. It does not read `members`, because member documents
//      carry email addresses, body weight, injuries and allergies, and no
//      feature is worth handing that to forty-seven strangers.
//
// And a member is signed in on one device at a time. `signedIn()` is true only
// for the account's most recent sign-in, so every rule built on it refuses an
// older device outright. See `signIns` below.
//
// WHAT THESE RULES CANNOT DO
//
// Rules validate shape, ownership and transitions. They cannot re-derive a
// value from data they do not have. Specifically, nothing here can check that a
// session's `setsDone` matches the sets the member actually logged, so
// `qualifies` — and the reward points that follow from it — is asserted by the
// client and merely shape-checked here. A determined member could inflate their
// own totals.
//
// The fix is to move the four writes that mint points (`saveSession`,
// `saveCheckIn`, `awardBadge`, `redeemAccessCode`) behind Callable Functions
// and deny those paths to clients outright. `FirestoreDataSource` is shaped so
// each becomes a one-line `httpsCallable`. Until then the exposure is bounded
// to a member cheating on their own leaderboard position, which is worth
// knowing about and is not worth blocking launch over.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    /**
     * Whether the caller's token comes from the account's latest sign-in.
     *
     * `auth_time` is when the device signed in, and a refreshed token keeps
     * it, so it names the sign-in rather than the token. `signIns/{uid}` holds
     * the latest. One `get`, billed as a read.
     */
    function onLatestSignIn() {
      let latest = get(/databases/$(database)/documents/signIns/$(request.auth.uid));
      return latest != null && latest.data.authTime == request.auth.token.auth_time;
    }

    /**
     * Signed in, on the device the account most recently signed in on.
     *
     * Every member rule starts here, so a device that has lost the account to
     * a later sign-in is refused everything but finding that out.
     */
    function signedIn() {
      return request.auth != null && onLatestSignIn();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * Coaches and admins, identified by a custom claim.
     *
     * Set with the Admin SDK (`setCustomUserClaims`), never from the client,
     * which is what makes it trustworthy here. Absent for every member.
     *
     * Read off the token alone, not through `signedIn()`: the console is not a
     * member's device and never claims one.
     */
    function isCoach() {
      return request.auth != null && request.auth.token.coach == true;
    }

    /** The caller's member document. One `get`, billed as a read. */
    function me() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function inCohort(cohortId) {
      return signedIn() && me().cohortId == cohortId;
    }

    /** Which fields a write is touching, whether it creates or updates. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /**
     * The name a member goes by in front of the cohort, derived the way every
     * client writer derives it: `profile.displayName || fallback`.
     *
     * The display name is fixed after setup (see `members` below), and this is
     * what makes that true everywhere the name is *seen*. The leaderboard row,
     * a chat message and a typing marker each carry a copy, and a copy the
     * caller chose freely would be a rename by another route.
     */
    function shownName(member, fallback) {
      let name = member.get('profile', {}).get('displayName', null);
      return name == null || name == '' ? fallback : name;
    }

    // --- Sign-ins ----------------------------------------------------------
    // `signIns/{uid}` — the account's latest sign-in, which is the one device
    // it is signed in on. `signedIn()` refuses every other.
    //
    // Outside `signedIn()` on purpose. A device that has lost the account has
    // to be able to read this to find out, and a device that has just signed
    // in has to write it before anything else will let it in.
    match /signIns/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Only the caller's own sign-in, and never one older than what is there.
      // The first stops a device naming a sign-in it did not make; the second
      // stops an older device taking the account back. Signing in again is
      // the only way back, and that makes it the latest.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['authTime', 'signedInAt'])
        && request.resource.data.authTime == request.auth.token.auth_time
        && request.resource.data.signedInAt == request.time
        && (resource == null || request.resource.data.authTime >= resource.data.authTime);

      // Clearing it would let a device signed out while offline come back,
      // find no claim, and take the account again.
      allow delete: if false;
    }

    // --- Access codes ------------------------------------------------------
    // `accessCodes/{code}` — keyed by the code itself.
    match /accessCodes/{code} {
      // `get` but never `list`. The code IS the secret, so looking one up by
      // name is the intended operation; enumerating the collection would hand
      // over every unredeemed seat in the business.
      allow get: if isCoach() || signedIn();
      allow list: if isCoach();

      allow create, delete: if isCoach();

      allow update: if isCoach() || (
        signedIn()
        // Only the unused → claimed transition, and only onto yourself.
        && resource.data.status == 'unused'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedByUid == request.auth.uid
        && request.time < resource.data.expiresAt
        // A code issued against a purchase is redeemable only by that buyer.
        // Compared case-insensitively, and it has to be: the address reaches
        // this rule from three different places — lowercased by the email-link
        // form, in whatever case the account was created with from Google, and
        // typed by hand into the console when the code was issued. An exact
        // match would cost a member their seat over a capital letter, and the
        // client-side check in `redeemAccessCode` folds case the same way, so
        // the two must agree or the transaction fails with a bare permission
        // error after the friendly check has already passed.
        && (resource.data.issuedToEmail == null
            || resource.data.issuedToEmail.lower() == request.auth.token.email.lower())
        // Nothing else moves. Without this, a claim could rewrite `cohortId`
        // and walk into a cohort the member never paid for.
        //
        // `issuedToEmail` and `issuedToWhatsapp` are absent from this list for
        // the same reason and it matters as much: they are who the seat was
        // sold to. A claim that could rewrite either could point somebody
        // else's code at itself, or quietly swap the number the coach uses to
        // reach a member. The buyer changing their own number does it on their
        // member document, after redemption, where it belongs.
        && changed().hasOnly([
             'status', 'claimedByUid', 'claimedByName', 'claimedAt',
             'updatedAt', 'updatedByUid', 'updatedByEmail'
           ])
      );
    }

    // --- Registrations -----------------------------------------------------
    // `registrations/{reference}` — one attempt to buy a seat, keyed by a
    // reference the landing site generates before the buyer is sent to Selar.
    //
    // Written only by `apps/web/server/api/register.post.ts` on the Admin SDK,
    // which bypasses these rules entirely. That is why every client write is
    // denied here rather than shape-checked: there is no legitimate client
    // write to allow, and a rule that permitted one would let anybody forge a
    // registration against a code they do not hold.
    //
    // Nor can a member read their own. It would have to be granted by matching
    // the address on the document, which means a rule that reads
    // `resource.data.email` — and that rule *errors* on a code with no
    // registration behind it, which is every code issued by hand in the
    // console, taking redemption down with it. The one field a member actually
    // needs is the WhatsApp number, and that reaches them a safer way: it is
    // copied onto the access code as `issuedToWhatsapp`, which they can already
    // read, and from there into their own profile at redemption.
    match /registrations/{reference} {
      allow get, list: if isCoach();
      allow write: if false;
    }

    // --- Unmatched sales ---------------------------------------------------
    // `unmatchedSales/{id}` — money that arrived with nothing to attach it to.
    //
    // Selar cannot be told our reference, so a sale is matched back to a
    // registration by the buyer's email address. Somebody who edits that
    // address on Selar's checkout form, or who buys from the product link
    // without ever filling in the form, produces a payment this site cannot
    // fulfil. Rather than lose it to a log line, `api/payment/webhook` writes
    // it here: a short queue of people who have paid and are owed a code by
    // hand.
    //
    // Same shape of rule as `registrations` above, and for the same reason —
    // the only writer is the Admin SDK, which bypasses these rules entirely,
    // so there is no legitimate client write to allow.
    match /unmatchedSales/{saleId} {
      allow get, list: if isCoach();
      allow write: if false;
    }

    // --- Programs ----------------------------------------------------------
    // Authored content. Every signed-in member reads it; only the console
    // writes it.
    match /programs/{programId} {
      allow read: if isCoach() || signedIn();
      allow write: if isCoach();

      match /{sub=**} {
        allow read: if isCoach() || signedIn();
      }

      // Weeks, guides, and the flat `workoutDays` a migration leaves behind.
      // Two segments only, so a training day below a week is not matched here:
      // rules grant if *any* matching statement allows, and a recursive
      // wildcard with a write would let a day around the checks below.
      match /{collection}/{docId} {
        allow write: if isCoach();
      }

      /**
       * An exercise's demo video: absent, null, or an https URL.
       *
       * Absent is accepted because every day authored before the field
       * existed has none, and a rule that reads a missing key errors, which
       * would deny an unrelated edit to that day. https only, because the app
       * plays it inline on the How to tab and a plain http source is blocked
       * as mixed content on an https page.
       */
      function validExercise(exercise) {
        return exercise is map
          && (!('videoUrl' in exercise)
              || exercise.videoUrl == null
              || (exercise.videoUrl is string
                  && exercise.videoUrl.size() <= 2048
                  && exercise.videoUrl.matches('https://.+')));
      }

      /** Rules cannot loop, so each slot is checked by index up to the cap. */
      function exerciseAt(exercises, i) {
        return exercises.size() <= i || validExercise(exercises[i]);
      }

      // A training day, with each exercise's video checked on the way in.
      //
      // The cap of 20 is what makes the per-index check complete: an exercise
      // past the last slot checked would go in unchecked.
      match /weeks/{weekId}/days/{dayId} {
        allow create, update: if isCoach()
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() <= 20
          && exerciseAt(request.resource.data.exercises, 0)
          && exerciseAt(request.resource.data.exercises, 1)
          && exerciseAt(request.resource.data.exercises, 2)
          && exerciseAt(request.resource.data.exercises, 3)
          && exerciseAt(request.resource.data.exercises, 4)
          && exerciseAt(request.resource.data.exercises, 5)
          && exerciseAt(request.resource.data.exercises, 6)
          && exerciseAt(request.resource.data.exercises, 7)
          && exerciseAt(request.resource.data.exercises, 8)
          && exerciseAt(request.resource.data.exercises, 9)
          && exerciseAt(request.resource.data.exercises, 10)
          && exerciseAt(request.resource.data.exercises, 11)
          && exerciseAt(request.resource.data.exercises, 12)
          && exerciseAt(request.resource.data.exercises, 13)
          && exerciseAt(request.resource.data.exercises, 14)
          && exerciseAt(request.resource.data.exercises, 15)
          && exerciseAt(request.resource.data.exercises, 16)
          && exerciseAt(request.resource.data.exercises, 17)
          && exerciseAt(request.resource.data.exercises, 18)
          && exerciseAt(request.resource.data.exercises, 19);
        allow delete: if isCoach();
      }
    }

    // --- Cohorts -----------------------------------------------------------
    match /cohorts/{cohortId} {
      allow read: if inCohort(cohortId) || isCoach();
      allow write: if isCoach();

      // Coach-authored announcements. Read state is per member and lives on
      // the member document, so nothing here is ever written by a client.
      match /notifications/{notificationId} {
        allow read: if inCohort(cohortId) || isCoach();
        allow write: if isCoach();
      }

      // The announcement deck behind the inbox: the same trust shape as the
      // notifications above, and a separate collection because the two are
      // authored differently and read on different screens. Longer-form,
      // card-shaped, and carrying a call to action the line-item inbox has no
      // room for. Nothing a member does writes one.
      match /announcements/{announcementId} {
        allow read: if inCohort(cohortId) || isCoach();
        allow write: if isCoach();
      }

      // The board projection: name, avatar, count. Deliberately the only
      // cross-member read in the system. See the header.
      match /leaderboard/{memberId} {
        allow read: if inCohort(cohortId) || isCoach();

        // Your own row only, and it can never carry more than these four
        // fields — this is the boundary that keeps the projection a
        // projection rather than a second copy of the member document.
        //
        // Split from delete deliberately. `allow write` would cover deletes
        // too, and on a delete `request.resource` is null, so the `keys()`
        // check errors and denies — which would have made a member unable to
        // remove their own row and broken `reset()`.
        //
        // The name is the member's own, never one the caller picked. Read with
        // `getAfter`, because redemption writes this row in the same
        // transaction that creates the member document, and `get` would not
        // see it yet. A row may also keep the name it already has: that is how
        // `deleteSession` writes, merging only the count, and it must not fail
        // on a row whose name went stale before this rule existed.
        allow create, update: if isCoach() || (
          isSelf(memberId)
          && request.resource.data.keys().hasOnly(
               ['name', 'avatarUrl', 'sessions', 'updatedAt'])
          && (
            request.resource.data.get('name', null) == shownName(
              getAfter(/databases/$(database)/documents/members/$(memberId)).data,
              'Member')
            || (resource != null
                && request.resource.data.get('name', null) == resource.data.get('name', null))
          )
        );
        allow delete: if isCoach() || isSelf(memberId);
      }

      // --- Threads -------------------------------------------------------
      // `cohort` is the group thread. Every other thread id is a member uid:
      // that member's private thread with the coach.
      //
      // The match is nested on the thread rather than spelled out per
      // subcollection so `myThread()` is written once. It gates both the
      // messages and the typing markers, and two copies of a predicate that
      // decides who may read a private thread with their coach is two copies
      // to keep in step.
      match /threads/{threadId} {
        function myThread() {
          return threadId == 'cohort' || threadId == request.auth.uid;
        }

        match /messages/{messageId} {
          /**
           * Whether a reaction moves `reactors` and `reactedAt` the one way it
           * may: the caller's own entry and nobody else's.
           *
           * Joining — no entry before, one after — is the only move that dates
           * the message, and it has to be made under the member's own name and
           * at `request.time`, since the entry is what the author's inbox
           * reads out ("Tomi reacted to your message") and a name or a time the
           * caller chose would be words put in someone else's mouth. Leaving
           * deletes the entry and dates nothing. Every other reaction touches
           * neither field, which is also what a build from before they existed
           * sends. The author never joins their own message.
           *
           * Keyed by uid so this is one map diff rather than a walk over a list,
           * which rules cannot do.
           */
          function movesOnlyOwnReactor() {
            let uid = request.auth.uid;
            let before = resource.data.get('reactors', {});
            let after = request.resource.data.get('reactors', {});
            let joined = !(uid in before) && uid in after;
            return after is map
              && after.diff(before).affectedKeys().hasOnly([uid])
              && (joined
                ? uid != resource.data.authorUid
                  && after[uid] == {'name': shownName(me(), 'Someone'), 'at': request.time}
                  && request.resource.data.reactedAt == request.time
                : request.resource.data.get('reactedAt', null) == resource.data.get('reactedAt', null)
                  && (!(uid in after) || after[uid] == before[uid]));
          }

          allow read: if isCoach() || (inCohort(cohortId) && myThread());

          allow create: if inCohort(cohortId)
            && myThread()
            && request.resource.data.authorUid == request.auth.uid
            // Posted under the member's own name. The edit rule below never lets
            // `authorName` move, so this is the only check it needs.
            && request.resource.data.authorName == shownName(me(), 'You')
            // Only the coach's messages get the coach's styling.
            && request.resource.data.isCoach == false
            // A new message starts with no reactions. Counts are only ever
            // moved by the increment below, and who reacted only ever by
            // `movesOnlyOwnReactor`.
            && request.resource.data.reactionCounts.size() == 0
            && !('reactors' in request.resource.data)
            && !('reactedAt' in request.resource.data)
            // Who it is aimed at, which is what puts it in their inbox. A list
            // when present; absent is still accepted, because a phone on a
            // build from before the field existed is still sending messages.
            //
            // Nothing here can check it against `mentions` and `replyTo` —
            // rules have no way to map over a list — so a member could reach
            // somebody without writing their name. That is no more than an
            // `@` already lets them do, and it reaches only their own cohort:
            // nobody else's inbox queries this thread.
            && (!('addressedUids' in request.resource.data)
                || request.resource.data.addressedUids is list);

          // Two writes may touch a sent message, and nothing else may.
          //
          // The first is a reaction: the tally, moved one emoji at a time by
          // anyone who can read the thread, and with it the caller's own entry
          // in who reacted — see `movesOnlyOwnReactor`.
          //
          // The second is the author correcting their own words, for fifteen
          // minutes and then never again — the window in `EDIT_WINDOW_MS`,
          // enforced here because a limit the client alone applies is a limit
          // anyone with the SDK can ignore. `hasOnly` on the four fields an
          // edit owns — the words, when they changed, who they name and so who
          // they reach — is what keeps an "edit" from being something else
          // wearing its name: an update free to move `sentAt` could re-date a
          // message back into a window it has left, one free to move
          // `authorUid` could hand it to somebody else, and one free to move
          // `reactionCounts` could invent applause. `editedAt` must be `request.time` rather than a value the
          // caller chose, because "Edited" is a claim about *when*, and the
          // caller is the only party with a reason to misstate it.
          //
          // The coach's exemption is the one already here: coach tooling runs
          // on the Admin SDK, which bypasses all of this anyway.
          allow update: if isCoach() || (
            inCohort(cohortId) && myThread()
            && (
              (changed().hasOnly(['reactionCounts', 'reactors', 'reactedAt'])
                && movesOnlyOwnReactor())
              || (
                changed().hasOnly(['text', 'editedAt', 'mentions', 'addressedUids'])
                && resource.data.authorUid == request.auth.uid
                && request.resource.data.editedAt == request.time
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.mentions is list
                && (!('addressedUids' in request.resource.data)
                    || request.resource.data.addressedUids is list)
                && request.time < resource.data.sentAt + duration.value(15, 'm')
              )
            )
          );

          allow delete: if isCoach() || (
            inCohort(cohortId) && resource.data.authorUid == request.auth.uid
          );

          // Who reacted, one document per reactor, keyed by uid so a member can
          // only ever move their own.
          match /reactions/{reactorId} {
            allow read: if isCoach() || inCohort(cohortId);
            allow write: if isSelf(reactorId) && inCohort(cohortId);
          }
        }

        // Who has the composer open, one document per person, keyed by uid.
        //
        // The two fields are the whole point of the restriction: a marker that
        // could carry arbitrary data would be a second, unmoderated way to put
        // text in front of the cohort, written to a path nothing renders as a
        // message and nobody would think to look at.
        match /typing/{typistId} {
          allow read: if isCoach() || (inCohort(cohortId) && myThread());

          // Split from delete for the reason the leaderboard block is split:
          // on a delete `request.resource` is null, so a `keys()` check on it
          // errors and denies — which would leave a member unable to say they
          // had stopped typing.
          allow create, update: if isCoach() || (
            isSelf(typistId)
            && inCohort(cohortId)
            && myThread()
            && request.resource.data.keys().hasOnly(['name', 'at'])
            && request.resource.data.name == shownName(me(), 'Someone')
          );

          allow delete: if isCoach() || (isSelf(typistId) && inCohort(cohortId));
        }
      }
    }

    // --- Members -----------------------------------------------------------
    // Private, without exception. Coach tooling runs on the Admin SDK.
    match /members/{uid} {
      allow read: if isSelf(uid);

      // Creating the member document is half of redeeming a code; the other
      // half is the claim above, and the two run in one transaction. The
      // fields checked here are the ones that decide what the member is
      // entitled to, so none of them may be self-assigned freely.
      allow create: if isSelf(uid)
        && request.resource.data.status == 'onboarding'
        && request.resource.data.accessCode is string
        && request.resource.data.email == request.auth.token.email
        // Points cannot be conjured at sign-up.
        && request.resource.data.stats.points == 0
        && request.resource.data.stats.sessionsQualified == 0
        // The cohort has to be the one the code actually belongs to.
        && request.resource.data.cohortId == get(
             /databases/$(database)/documents/accessCodes/$(request.resource.data.accessCode)
           ).data.cohortId;

      allow update: if isSelf(uid)
        // Immutable once set: these define who the member is and what they
        // paid for, and a self-service change to any of them is an attack.
        && request.resource.data.cohortId == resource.data.cohortId
        && request.resource.data.accessCode == resource.data.accessCode
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.programId == resource.data.programId
        // The one status move a member makes for themselves is finishing
        // setup, in `completeSetup`. Writing `onboarding` back would reopen the
        // two fields locked below; every other move is the console's.
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'onboarding'
                && request.resource.data.status == 'active'))
        // Display name and height are answered at setup and fixed after it.
        // Read with `get` so a document from before either field existed
        // still takes other updates: a missing key is null on both sides.
        && (resource.data.status == 'onboarding' || (
          request.resource.data.get('profile', {}).get('displayName', null)
            == resource.data.get('profile', {}).get('displayName', null)
          && request.resource.data.get('profile', {}).get('heightCm', null)
            == resource.data.get('profile', {}).get('heightCm', null)
        ));

      // Coach only. A member who could delete their own document could redeem
      // their code again, which rebuilds it in `onboarding` and hands back the
      // setup screens the lock above exists to close. The client's `reset()`
      // is the one writer this refuses, and nothing in the app calls it.
      allow delete: if isCoach();

      // Everything below a member belongs to that member alone. One rule
      // rather than eight: sessions, photos, badges, the active session,
      // notification read state and lifecycle events all share the same
      // answer, and listing them separately invites one to drift.
      //
      // Check-ins are carved out by name rather than overridden below, because
      // rules are additive: a narrower block cannot take away what this one
      // grants, so this one has to not grant it.
      match /{collection}/{docId} {
        allow read, write: if isSelf(uid) && collection != 'checkIns';
      }

      // A week's check-in is sent once and stays as sent. The week is the
      // document id, so a second submission for the same week is an update,
      // and there is no update — nor a delete to clear the way for one.
      match /checkIns/{weekId} {
        allow read, create: if isSelf(uid);
      }
    }
  }
}
