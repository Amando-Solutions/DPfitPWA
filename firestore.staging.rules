rules_version = '2';

// =============================================================================
// DP Fitness — Firestore security rules
//
// The app talks to Firestore directly from the browser, so these rules are the
// only thing standing between a member and everyone else's data. Read them as
// the real access-control policy, not as a formality.
//
// Two principles run through the whole file:
//
//   1. A member reads their own documents and writes their own documents.
//      Everything under `members/{uid}` is gated on `uid == request.auth.uid`.
//      The one other caller is an operator (`isOperator()`: the console's
//      `dpfitAdmin` claim, or the legacy `coach` one), who may read a member
//      for support and make a few audited writes — pause, resume, review —
//      but never edit a profile. No other member ever reads one.
//
//   2. Anything shared with the cohort is a projection, never the source.
//      The leaderboard reads `cohorts/{id}/leaderboard`, which holds a name, an
//      avatar and a count. It does not read `members`, because member documents
//      carry email addresses, body weight, injuries and allergies, and no
//      feature is worth handing that to forty-seven strangers.
//
// And a member is signed in on one device at a time. `signedIn()` is true only
// for the account's most recent sign-in, so every rule built on it refuses an
// older device outright. See `signIns` below.
//
// And once a cohort is over — archived, or past its last day — its members
// write nothing more to it. See `cohortRunning`.
//
// WHAT THESE RULES CANNOT DO
//
// Rules validate shape, ownership and transitions. They cannot re-derive a
// value from data they do not have — and they have no time zones, so they
// cannot say what day it is for a member in New York.
//
// So the writes that are locked to a day or a week are not made here at all.
// A session, a check-in and a progress photo are written by Callable Functions
// (`logSession`, `submitCheckIn`, `logPhoto` in `apps/functions`), which read
// the server's clock and the member's stored region, and the rules below deny
// those paths to clients outright. The region itself (`members/{uid}.region`)
// is written only by `setRegion`, which is what keeps a change forward-only.
//
// Still client-written: `awardBadge`, `redeemAccessCode`, and the member's own
// `stats`, which nothing below locks. A determined member could inflate their
// own totals that way. Moving those behind functions too closes it; until then
// the exposure is bounded to a member cheating on their own leaderboard
// position, which is worth knowing about and is not worth blocking launch over.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    /**
     * Whether the caller's token comes from the account's latest sign-in.
     *
     * `auth_time` is when the device signed in, and a refreshed token keeps
     * it, so it names the sign-in rather than the token. `signIns/{uid}` holds
     * the latest. One `get`, billed as a read.
     */
    function onLatestSignIn() {
      let latest = get(/databases/$(database)/documents/signIns/$(request.auth.uid));
      return latest != null && latest.data.authTime == request.auth.token.auth_time;
    }

    /**
     * The caller's member document, or `null` before they have one.
     *
     * One `get`, of the same document `me()` reads: a request that calls both
     * is billed for one read.
     */
    function membership() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    /**
     * Whether the account still has the email its membership was made with.
     *
     * A code is claimed only by an account under the address it was issued to,
     * and that is what makes a code in the wrong hands recoverable: whoever used
     * it made the account under the buyer's address, so the buyer's password
     * reset takes it back. The app offers no way to change an email, but
     * Firebase lets any signed-in account change its own through the public
     * API — and an account moved to another address is out of that reset's
     * reach.
     *
     * Rules cannot stop that change; Auth is not governed by them. They can make
     * it worthless. The address is fixed on the member document (see `members`
     * below), and an account whose email no longer matches it is refused
     * everything a member can do.
     *
     * No member document yet passes, because nothing is bound: the claim and
     * the document it creates check the address against the code directly. Nor
     * does a document with no email on it, which creation cannot produce, so a
     * stray one is not a member locked out. Case is folded, as everywhere an
     * address is compared.
     *
     * Support changing a member's email on the Admin SDK has to change
     * `members/{uid}.email` with it, or the member is locked out.
     */
    function keepsMemberEmail(member) {
      let bound = member == null ? '' : member.data.get('email', '');
      return bound == ''
        || bound.lower() == request.auth.token.get('email', '').lower();
    }

    /**
     * Whether this sign-in may act for the account.
     *
     * A password or an email link is trusted as it is. Google is different,
     * because it can be *added* to an account afterwards: anybody signed in can
     * link their own Google account through the public API, and a password
     * reset does not unlink it. Whoever made an account with somebody else's
     * code could link Google, and keep a way in after the buyer reset the
     * password and took the account back.
     *
     * So a Google sign-in counts when Firebase has verified the account's
     * address — as it has for a Gmail member signing in with their own Google
     * account, and has not for an account made with a password under somebody
     * else's address — or for a fieldless legacy membership created before the
     * compatibility cutoff. The cutoff matters because the current PWA omits
     * `joinedWith`: accepting every missing value forever would let a new
     * password member link an unverified Google identity and keep using it.
     *
     * Before there is a membership, a Google sign-in needs the verified address:
     * otherwise a linked Google account could redeem the code itself.
     */
    function trustsSignIn(member) {
      return request.auth.token.firebase.sign_in_provider != 'google.com'
        || request.auth.token.get('email_verified', false) == true
        || (member != null
            && !('joinedWith' in member.data)
            && member.data.get('createdAt', timestamp.date(1970, 1, 1))
                 < timestamp.date(2026, 9, 20));
    }

    /**
     * Signed in, on the device the account most recently signed in on, under
     * the email its membership was made with, by a sign-in the account trusts.
     *
     * Every member rule starts here, so a device that has lost the account to
     * a later sign-in is refused everything but finding that out, and an
     * account that has changed its email or been reached through a linked
     * Google account is refused everything.
     */
    function signedIn() {
      return request.auth != null && onLatestSignIn() && inGoodStanding(membership());
    }

    /** Split out so the member document is only read once somebody is signed in. */
    function inGoodStanding(member) {
      return keepsMemberEmail(member) && trustsSignIn(member);
    }

    /**
     * A member: all of `signedIn()`, and a member document behind it.
     *
     * An account alone is not a purchase. Anybody can make one with a single
     * request to Firebase's sign-up API, which takes the public key in the app's
     * own JavaScript and no access code; the membership is what the code buys.
     */
    function isMember() {
      return signedIn() && membership() != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * Coaches and admins, identified by a custom claim.
     *
     * Set with the Admin SDK (`setCustomUserClaims`), never from the client,
     * which is what makes it trustworthy here. Absent for every member.
     *
     * Read off the token alone, not through `signedIn()`: the console is not a
     * member's device and never claims one.
     */
    function isCoach() {
      return request.auth != null && request.auth.token.coach == true;
    }

    /**
     * The single admin console identity. Kept separate from `isCoach()` so
     * the legacy claim can be retired without changing the console contract.
     */
    function isAdmin() {
      return request.auth != null && request.auth.token.dpfitAdmin == true;
    }

    /** Trusted back-office callers during the coach -> dpfitAdmin migration. */
    function isOperator() {
      return isCoach() || isAdmin();
    }

    /** The caller's member document. One `get`, billed as a read. */
    function me() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function inCohort(cohortId) {
      return signedIn() && me().cohortId == cohortId;
    }

    /**
     * Whether the cohort is still running: not completed or archived, and not past the last
     * day its `endDate` names.
     *
     * Once it is over a member can still read, because the ended screen shows
     * their totals, and can write nothing the cohort holds: no message,
     * reaction, typing marker, board row, profile change, badge, read marker or
     * workout state. The member app stops trying the moment it knows. These
     * are for when it does not: a message queued offline and replayed after
     * the end, a build from before this, or the SDK driven by hand.
     *
     * `endDate` is a day, read on the cohort's calendar, and the cohort runs
     * to the end of it (`cohortOver` in the member app and the functions).
     * Rules have no time zones, so this closes 24 hours after the stored
     * instant: exactly the midnight after the last day when the console stores
     * midnight in the cohort's zone, as it does for `startDate`, and never
     * before the app closes for any other time on that day. No usable
     * `endDate` is no end on the calendar; archiving still closes it. A
     * missing cohort document says nothing either way, which is how the app
     * reads it too.
     *
     * One `get`, billed as a read, on every write it guards. `storage.rules`
     * restates this for uploads; keep the two in step.
     */
    function cohortRunning(cohortId) {
      let cohort = get(/databases/$(database)/documents/cohorts/$(cohortId));
      return cohort == null || cohortStillOn(cohort.data);
    }

    /**
     * The test itself, on a cohort document that exists.
     *
     * `endDate` is read twice on purpose: `get` with a default for the type
     * check, then the field itself for the sum. Binding the `get` to a name
     * instead types that name as possibly `null`, and the compiler refuses
     * `null + duration` even behind the `is timestamp` check that rules it out.
     */
    function cohortStillOn(cohort) {
      return !(cohort.get('status', '') in ['archived', 'completed'])
        && !(cohort.get('endDate', null) is timestamp
             && request.time >= cohort.endDate + duration.value(1, 'd'));
    }

    /** Which fields a write is touching, whether it creates or updates. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function hasOperatorUpdateAudit() {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email;
    }

    function isValidOperatorRevoke() {
      return resource.data.status in ['unused', 'claimed']
        && changed().hasOnly([
          'status', 'revokedAt', 'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedAt == request.time
        && hasOperatorUpdateAudit();
    }

    /**
     * The name a member goes by in front of the cohort, derived the way every
     * client writer derives it: `profile.displayName || fallback`.
     *
     * The display name is fixed after setup (see `members` below), and this is
     * what makes that true everywhere the name is *seen*. The leaderboard row,
     * a chat message and a typing marker each carry a copy, and a copy the
     * caller chose freely would be a rename by another route.
     */
    function shownName(member, fallback) {
      let name = member.get('profile', {}).get('displayName', null);
      return name == null || name == '' ? fallback : name;
    }

    // --- Sign-ins ----------------------------------------------------------
    // `signIns/{uid}` — the account's latest sign-in, which is the one device
    // it is signed in on. `signedIn()` refuses every other.
    //
    // Outside `signedIn()` on purpose. A device that has lost the account has
    // to be able to read this to find out, and a device that has just signed
    // in has to write it before anything else will let it in.
    match /signIns/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Only the caller's own sign-in, and never one older than what is there.
      // The first stops a device naming a sign-in it did not make; the second
      // stops an older device taking the account back. Signing in again is
      // the only way back, and that makes it the latest.
      //
      // And only by a sign-in the account trusts. A Google account linked to
      // somebody else's membership could otherwise sign that member out of
      // every device, over and over, even though `signedIn()` gives it
      // nothing to read.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && trustsSignIn(membership())
        && request.resource.data.keys().hasOnly(['authTime', 'signedInAt'])
        && request.resource.data.authTime == request.auth.token.auth_time
        && request.resource.data.signedInAt == request.time
        && (resource == null || request.resource.data.authTime >= resource.data.authTime);

      // Clearing it would let a device signed out while offline come back,
      // find no claim, and take the account again.
      allow delete: if false;
    }

    // --- Access codes ------------------------------------------------------
    // `accessCodes/{code}` — keyed by the code itself.
    match /accessCodes/{code} {
      // `get` but never `list`. The code IS the secret, so looking one up by
      // name is the intended operation; enumerating the collection would hand
      // over every unredeemed seat in the business.
      //
      // Not gated on sign-in, because the code comes before the account: it is
      // checked — real, unused, in date — before there is anybody to sign in,
      // and the address it was issued to is compared before an account is made
      // for it. What that exposes is this one document to whoever already holds
      // its code: the buyer's own address and number, to the buyer. A generated
      // code is 40 random bits, so holding one means having been sent it.
      // Everything that *spends* a code is still signed in, below.
      allow get: if true;
      allow list: if isOperator();

      // No client creates a code, a coach included. `apps/functions` mints
      // every one on the Admin SDK, so the shape of a seat is decided in one
      // place; a hand-written document is how codes that cannot be redeemed
      // got into this collection before.
      allow create: if false;
      allow delete: if false;

      allow update: if (isOperator() && isValidOperatorRevoke()) || (
        signedIn()
        // Only the unused → claimed transition, and only onto yourself.
        && resource.data.status == 'unused'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedByUid == request.auth.uid
        && request.time < resource.data.expiresAt
        // A code issued against a purchase is redeemable only by that buyer.
        // Compared case-insensitively, and it has to be: the address reaches
        // this rule from three different places — lowercased by the sign-up
        // form, in whatever case the account was created with from Google, and
        // typed by hand into the console when the code was issued. An exact
        // match would cost a member their seat over a capital letter, and the
        // client-side check in `redeemAccessCode` folds case the same way, so
        // the two must agree or the transaction fails with a bare permission
        // error after the friendly check has already passed.
        && (resource.data.issuedToEmail == null
            || resource.data.issuedToEmail.lower() == request.auth.token.email.lower())
        // Nothing else moves. Without this, a claim could rewrite `cohortId`
        // and walk into a cohort the member never paid for.
        //
        // `issuedToEmail` and `issuedToWhatsapp` are absent from this list for
        // the same reason and it matters as much: they are who the seat was
        // sold to. A claim that could rewrite either could point somebody
        // else's code at itself, or quietly swap the number the coach uses to
        // reach a member. The buyer changing their own number does it on their
        // member document, after redemption, where it belongs.
        && changed().hasOnly([
             'status', 'claimedByUid', 'claimedByName', 'claimedAt',
             'updatedAt', 'updatedByUid', 'updatedByEmail'
           ])
        && request.resource.data.claimedByName is string
        && request.resource.data.claimedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email
        // Claim and membership are one transaction. The entitlement copied
        // to the member has to be the entitlement this exact code grants.
        && getAfter(
             /databases/$(database)/documents/members/$(request.auth.uid)
           ).data.accessCode == resource.data.code
        && getAfter(
             /databases/$(database)/documents/members/$(request.auth.uid)
           ).data.cohortId == resource.data.cohortId
        && getAfter(
             /databases/$(database)/documents/members/$(request.auth.uid)
           ).data.programId == resource.data.get('programId', '')
        && getAfter(
             /databases/$(database)/documents/members/$(request.auth.uid)
           ).data.programVersion == resource.data.get('programVersion', 1)
      );
    }

    // --- Registrations -----------------------------------------------------
    // `registrations/{reference}` — one attempt to buy a seat, keyed by a
    // reference the landing site generates before the buyer is sent to Selar.
    //
    // Written only by `apps/web/server/api/register.post.ts` on the Admin SDK,
    // which bypasses these rules entirely. That is why every client write is
    // denied here rather than shape-checked: there is no legitimate client
    // write to allow, and a rule that permitted one would let anybody forge a
    // registration against a code they do not hold.
    //
    // Nor can a member read their own. It would have to be granted by matching
    // the address on the document, which means a rule that reads
    // `resource.data.email` — and that rule *errors* on a code with no
    // registration behind it, which is every code issued by hand in the
    // console, taking redemption down with it. The one field a member actually
    // needs is the WhatsApp number, and that reaches them a safer way: it is
    // copied onto the access code as `issuedToWhatsapp`, which they can already
    // read, and from there into their own profile at redemption.
    match /registrations/{reference} {
      allow get, list: if isOperator();
      allow write: if false;
    }

    // --- Unmatched sales ---------------------------------------------------
    // `unmatchedSales/{id}` — money that arrived with nothing to attach it to.
    //
    // Selar cannot be told our reference, so a sale is matched back to a
    // registration by the buyer's email address. Somebody who edits that
    // address on Selar's checkout form, or who buys from the product link
    // without ever filling in the form, produces a payment this site cannot
    // fulfil. Rather than lose it to a log line, `api/payment/webhook` writes
    // it here: a short queue of people who have paid and are owed a code by
    // hand.
    //
    // Same shape of rule as `registrations` above, and for the same reason —
    // the only writer is the Admin SDK, which bypasses these rules entirely,
    // so there is no legitimate client write to allow.
    match /unmatchedSales/{saleId} {
      allow get, list: if isOperator();
      allow write: if false;
    }

    // --- Programs ----------------------------------------------------------
    // Authored content, and the thing members pay for. Members read it — not
    // every account, since an account costs nothing and a membership costs a
    // code; see `isMember`. Only the console writes it.
    match /settings/platform {
      allow read: if isOperator() || isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'qualifyingSetPercent', 'autoIssueCodes', 'multipleCohorts', 'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.qualifyingSetPercent is int
        && request.resource.data.qualifyingSetPercent >= 1
        && request.resource.data.qualifyingSetPercent <= 100
        // Read by the landing site's payment webhook (Admin SDK); absent means on.
        && request.resource.data.get('autoIssueCodes', true) is bool
        // Console-only: off allows one active cohort at a time. Absent means on.
        && request.resource.data.get('multipleCohorts', true) is bool
        && hasOperatorUpdateAudit();
      allow delete: if false;
    }

    // What anyone may see before they have an account: the coach's name and
    // WhatsApp number, offered on the access-code screen when a code fails.
    // Public on purpose; nothing here is private and it is one small document.
    match /settings/public {
      allow get: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'coachName', 'coachWhatsapp', 'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.coachName is string
        && request.resource.data.coachName.size() <= 80
        && request.resource.data.coachWhatsapp is string
        && request.resource.data.coachWhatsapp.matches('^[+0-9 ()-]{0,30}$')
        && hasOperatorUpdateAudit();
      allow delete: if false;
    }

    // The Workout sessions feed: one collection-group query over every member's
    // sessions. Read-only, operators only; members still reach just their own
    // through members/{uid}/sessions below.
    match /{path=**}/sessions/{sessionId} {
      allow read: if isOperator();
    }

    // The Feedback screen: every member's weekly check-in in one collection-
    // group query. Read-only, operators only; reviews still go through
    // members/{uid}/checkIns below.
    match /{path=**}/checkIns/{checkInId} {
      allow read: if isOperator();
    }

    // The shared exercise library. Not scoped to a program: "Back Squat" is the
    // same exercise everywhere. Names are unique through exerciseLibraryNames,
    // one doc per normalised (trimmed, single-spaced, lowercased) name, written
    // in the same transaction as the entry it points at.
    match /exerciseLibrary/{exerciseId} {
      allow read: if isOperator() || isMember();

      function validLibraryEntry() {
        let entry = request.resource.data;
        return entry.keys().hasOnly([
            'name', 'nameKey', 'defaultType', 'videoUrl', 'muscleGroup', 'archived',
            'createdAt', 'updatedAt', 'updatedByUid', 'updatedByEmail'
          ])
          && entry.name is string
          && entry.name.size() >= 2 && entry.name.size() <= 80
          && entry.name == entry.name.trim()
          && !entry.name.matches('.*\\s\\s.*')
          && entry.nameKey == entry.name.lower()
          && entry.defaultType in [
               'weight-reps', 'bodyweight-reps', 'weighted-bodyweight', 'assisted-bodyweight',
               'duration', 'weight-duration', 'distance-duration', 'weight-distance'
             ]
          && (entry.videoUrl == null
              || (entry.videoUrl is string
                  && entry.videoUrl.size() <= 2048
                  && entry.videoUrl.matches('https://.+')))
          && entry.muscleGroup is string && entry.muscleGroup.size() <= 40
          && entry.archived is bool
          && getAfter(/databases/$(database)/documents/exerciseLibraryNames/$(entry.nameKey)).data.exerciseId == exerciseId
          && hasOperatorUpdateAudit();
      }

      allow create, update: if isOperator() && validLibraryEntry();
      // Its name reservation goes in the same write.
      allow delete: if isOperator()
        && !existsAfter(/databases/$(database)/documents/exerciseLibraryNames/$(resource.data.nameKey));
    }

    match /exerciseLibraryNames/{nameKey} {
      allow read: if isOperator();
      // Created, never reassigned: a taken name can't be handed to another entry.
      allow create: if isOperator()
        && request.resource.data.keys().hasOnly(['exerciseId'])
        && getAfter(/databases/$(database)/documents/exerciseLibrary/$(request.resource.data.exerciseId)).data.nameKey == nameKey;
      // Released only when its entry is deleted or renamed away in the same write.
      allow delete: if isOperator()
        && (!existsAfter(/databases/$(database)/documents/exerciseLibrary/$(resource.data.exerciseId))
            || getAfter(/databases/$(database)/documents/exerciseLibrary/$(resource.data.exerciseId)).data.nameKey != nameKey);
    }

    // Scheduled cohort calls: one-off, dated, each for a single cohort. The PWA
    // reads its own cohort's calls directly (a `where cohortId ==` query, which
    // this rule can check) and shows the one on today's date.
    match /liveCalls/{callId} {
      allow read: if isOperator() || inCohort(resource.data.cohortId);
      allow create, update: if isOperator()
        && request.resource.data.keys().hasOnly([
             'title', 'cohortId', 'cohortName', 'startsAt', 'durationMinutes', 'joinUrl',
             'updatedAt', 'updatedByUid', 'updatedByEmail'
           ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.cohortId is string
        && exists(/databases/$(database)/documents/cohorts/$(request.resource.data.cohortId))
        && request.resource.data.cohortName is string && request.resource.data.cohortName.size() <= 100
        && request.resource.data.startsAt is timestamp
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 5 && request.resource.data.durationMinutes <= 480
        && request.resource.data.joinUrl is string
        && request.resource.data.joinUrl.size() <= 2048
        && request.resource.data.joinUrl.matches('https://\\S+')
        && hasOperatorUpdateAudit();
      allow delete: if isOperator();
    }

    match /programs/{programId} {
      allow read: if isOperator() || isMember();

      function programIsDraft() {
        return get(
          /databases/$(database)/documents/programs/$(programId)
        ).data.status == 'draft';
      }

      function programData() {
        return get(/databases/$(database)/documents/programs/$(programId)).data;
      }

      // Live edits to a published program touch content, never structure:
      // only the schedule revision and audit fields may change on the parent.
      function validLiveScheduleEdit() {
        return resource.data.status == 'published'
          && request.resource.data.status == 'published'
          && request.resource.data.scheduleRevision == resource.data.get('scheduleRevision', 0) + 1
          && hasOperatorUpdateAudit()
          && changed().hasOnly([
               'scheduleRevision', 'updatedAt', 'updatedByUid', 'updatedByEmail'
             ]);
      }

      function validPublish() {
        return resource.data.status == 'draft'
          && request.resource.data.status == 'published'
          && request.resource.data.workoutDayCount > 0
          && request.resource.data.weekThemesConfigured == true
          && request.resource.data.rewardsConfigured == true
          && request.resource.data.publishedAt == request.time
          && hasOperatorUpdateAudit()
          && changed().hasOnly([
               'status', 'publishedAt', 'updatedAt',
               'updatedByUid', 'updatedByEmail'
             ]);
      }

      // A published version keeps its structure. Content edits to its weekly
      // schedule go through validLiveScheduleEdit and the /weeks rule below;
      // anything structural happens in a new draft from cloneProgramVersion.
      allow create: if isOperator()
        && request.resource.data.status == 'draft'
        && request.resource.data.publishedAt == null;
      allow update: if isOperator()
        && (
          (resource.data.status == 'draft'
            && ((request.resource.data.status == 'draft' && hasOperatorUpdateAudit())
                || validPublish()))
          || validLiveScheduleEdit()
        );
      allow delete: if isOperator() && resource.data.status == 'draft';

      match /{sub=**} {
        allow read: if isOperator() || isMember();
      }

      // Weeks, guides, and the flat `workoutDays` a migration leaves behind.
      // Two segments only, so a training day below a week is not matched here:
      // rules grant if *any* matching statement allows, and a recursive
      // wildcard with a write would let a day around the checks below.
      match /{collection}/{docId} {
        allow write: if isOperator() && programIsDraft();
      }

      // A published week can be edited live, but keeps its number and the
      // same days in the same order. Create only freezes a week that still
      // reads the legacy flat schedule, and only within the program's length.
      //
      // Only console-shaped week documents (a `days` list) are writable here.
      // The PWA's own week documents (title, dates, a nested `days`
      // subcollection) share the `week-N` ids and must never be overwritten.
      match /weeks/{weekId} {
        function validLiveWeek() {
          return isOperator()
            && programData().status == 'published'
            && request.resource.data.keys().hasOnly([
                 'weekNumber', 'days', 'updatedAt', 'updatedByUid', 'updatedByEmail'
               ])
            && request.resource.data.weekNumber is int
            && request.resource.data.weekNumber >= 1
            && request.resource.data.weekNumber <= programData().totalWeeks
            && weekId == 'week-' + string(request.resource.data.weekNumber)
            && request.resource.data.days is list
            && request.resource.data.days.size() > 0
            && request.resource.data.days.size() <= 14
            && hasOperatorUpdateAudit();
        }

        /** Rules cannot loop, so each day slot is compared by index up to 14. */
        function sameDayAt(i) {
          return request.resource.data.days.size() <= i
            || (request.resource.data.days[i].id == resource.data.days[i].id
                && request.resource.data.days[i].dayNumber == resource.data.days[i].dayNumber);
        }

        allow create: if validLiveWeek();
        allow update: if validLiveWeek()
          && 'days' in resource.data
          && resource.data.days is list
          && request.resource.data.weekNumber == resource.data.weekNumber
          && request.resource.data.days.size() == resource.data.days.size()
          && sameDayAt(0) && sameDayAt(1) && sameDayAt(2) && sameDayAt(3)
          && sameDayAt(4) && sameDayAt(5) && sameDayAt(6) && sameDayAt(7)
          && sameDayAt(8) && sameDayAt(9) && sameDayAt(10) && sameDayAt(11)
          && sameDayAt(12) && sameDayAt(13);
      }

      /**
       * An exercise's demo video: absent, null, or an https URL.
       *
       * Absent is accepted because every day authored before the field
       * existed has none, and a rule that reads a missing key errors, which
       * would deny an unrelated edit to that day. https only, because the app
       * plays it inline on the How to tab and a plain http source is blocked
       * as mixed content on an https page.
       */
      function validExercise(exercise) {
        return exercise is map
          && (!('videoUrl' in exercise)
              || exercise.videoUrl == null
              || (exercise.videoUrl is string
                  && exercise.videoUrl.size() <= 2048
                  && exercise.videoUrl.matches('https://.+')));
      }

      /** Rules cannot loop, so each slot is checked by index up to the cap. */
      function exerciseAt(exercises, i) {
        return exercises.size() <= i || validExercise(exercises[i]);
      }

      // A training day, with each exercise's video checked on the way in.
      //
      // The cap of 20 is what makes the per-index check complete: an exercise
      // past the last slot checked would go in unchecked.
      // A library rename or video change reaches a published day: only the
      // exercise list may change, keeping its length, with videos checked.
      function validLiveExerciseSync() {
        return isOperator()
          && programData().status == 'published'
          && changed().hasOnly(['exercises', 'updatedAt', 'updatedByUid', 'updatedByEmail'])
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() == resource.data.exercises.size()
          && request.resource.data.exercises.size() <= 20
          && hasOperatorUpdateAudit()
          && exerciseAt(request.resource.data.exercises, 0)
          && exerciseAt(request.resource.data.exercises, 1)
          && exerciseAt(request.resource.data.exercises, 2)
          && exerciseAt(request.resource.data.exercises, 3)
          && exerciseAt(request.resource.data.exercises, 4)
          && exerciseAt(request.resource.data.exercises, 5)
          && exerciseAt(request.resource.data.exercises, 6)
          && exerciseAt(request.resource.data.exercises, 7)
          && exerciseAt(request.resource.data.exercises, 8)
          && exerciseAt(request.resource.data.exercises, 9)
          && exerciseAt(request.resource.data.exercises, 10)
          && exerciseAt(request.resource.data.exercises, 11)
          && exerciseAt(request.resource.data.exercises, 12)
          && exerciseAt(request.resource.data.exercises, 13)
          && exerciseAt(request.resource.data.exercises, 14)
          && exerciseAt(request.resource.data.exercises, 15)
          && exerciseAt(request.resource.data.exercises, 16)
          && exerciseAt(request.resource.data.exercises, 17)
          && exerciseAt(request.resource.data.exercises, 18)
          && exerciseAt(request.resource.data.exercises, 19);
      }

      match /workoutDays/{dayId} {
        allow update: if validLiveExerciseSync();
      }

      match /weeks/{weekId}/days/{dayId} {
        allow update: if validLiveExerciseSync();
        allow create, update: if isOperator()
          && programIsDraft()
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() <= 20
          && exerciseAt(request.resource.data.exercises, 0)
          && exerciseAt(request.resource.data.exercises, 1)
          && exerciseAt(request.resource.data.exercises, 2)
          && exerciseAt(request.resource.data.exercises, 3)
          && exerciseAt(request.resource.data.exercises, 4)
          && exerciseAt(request.resource.data.exercises, 5)
          && exerciseAt(request.resource.data.exercises, 6)
          && exerciseAt(request.resource.data.exercises, 7)
          && exerciseAt(request.resource.data.exercises, 8)
          && exerciseAt(request.resource.data.exercises, 9)
          && exerciseAt(request.resource.data.exercises, 10)
          && exerciseAt(request.resource.data.exercises, 11)
          && exerciseAt(request.resource.data.exercises, 12)
          && exerciseAt(request.resource.data.exercises, 13)
          && exerciseAt(request.resource.data.exercises, 14)
          && exerciseAt(request.resource.data.exercises, 15)
          && exerciseAt(request.resource.data.exercises, 16)
          && exerciseAt(request.resource.data.exercises, 17)
          && exerciseAt(request.resource.data.exercises, 18)
          && exerciseAt(request.resource.data.exercises, 19);
        allow delete: if isOperator() && programIsDraft();
      }
    }

    // --- Cohorts -----------------------------------------------------------
    match /cohorts/{cohortId} {
      allow read: if inCohort(cohortId) || isOperator();

      function keepsActiveProgramPin() {
        return resource.data.status != 'active'
          || resource.data.get('programId', null) == null
          || (
            request.resource.data.get('programId', null) == resource.data.programId
            && request.resource.data.get('programName', null) == resource.data.get('programName', null)
            && request.resource.data.get('programVersion', null) == resource.data.get('programVersion', null)
          );
      }

      // An archived cohort is frozen but for one write: the admin's "Reopen
      // cohort". It goes back to active (draft with no program) and clears
      // `archivedAt`. A cohort past its last day may get a later one in the
      // same write, or its members stay on "Your cohort has ended".
      function isReopen() {
        return request.resource.data.status in ['draft', 'active']
          && request.resource.data.get('archivedAt', null) == null
          && changed().hasOnly([
            'status', 'archivedAt', 'endDate', 'updatedAt', 'updatedByUid', 'updatedByEmail'
          ])
          && (!changed().hasAny(['endDate']) || request.resource.data.endDate is timestamp);
      }

      allow create: if isOperator();
      allow update: if isOperator()
        && (resource.data.status != 'archived' || isReopen())
        && request.resource.data.status in ['draft', 'active', 'completed', 'archived']
        && keepsActiveProgramPin()
        && hasOperatorUpdateAudit();
      allow delete: if isOperator()
        && resource.data.status == 'draft'
        && resource.data.get('memberCount', 0) == 0;

      // Coach-authored announcements. Read state is per member and lives on
      // the member document, so nothing here is ever written by a client.
      match /notifications/{notificationId} {
        allow read: if inCohort(cohortId) || isOperator();
        allow write: if isOperator();
      }

      // The announcement deck behind the inbox: the same trust shape as the
      // notifications above, and a separate collection because the two are
      // authored differently and read on different screens. Longer-form,
      // card-shaped, and carrying a call to action the line-item inbox has no
      // room for. Nothing a member does writes one.
      match /announcements/{announcementId} {
        allow read: if inCohort(cohortId) || isOperator();
        allow write: if isOperator();
      }

      // The board projection: name, avatar, count. Deliberately the only
      // cross-member read in the system. See the header.
      match /leaderboard/{memberId} {
        allow read: if inCohort(cohortId) || isOperator();

        // Your own row only, and it can never carry more than these four
        // fields — this is the boundary that keeps the projection a
        // projection rather than a second copy of the member document.
        //
        // Split from delete deliberately. `allow write` would cover deletes
        // too, and on a delete `request.resource` is null, so the `keys()`
        // check errors and denies — which would have made a member unable to
        // remove their own row and broken `reset()`.
        //
        // The name is the member's own, never one the caller picked. Read with
        // `getAfter`, because redemption writes this row in the same
        // transaction that creates the member document, and `get` would not
        // see it yet. A row may also keep the name it already has: that is how
        // `deleteSession` writes, merging only the count, and it must not fail
        // on a row whose name went stale before this rule existed.
        //
        // A row stops moving once the cohort is over. A *first* row does not
        // wait on that: redemption writes it, and somebody redeeming a code
        // for a cohort that has since ended belongs on the screen that says
        // so, not on a refusal at the door that cannot say why.
        allow create, update: if isOperator() || (
          isSelf(memberId)
          && (resource == null || cohortRunning(cohortId))
          && request.resource.data.keys().hasOnly(
               ['name', 'avatarUrl', 'sessions', 'updatedAt'])
          && (
            request.resource.data.get('name', null) == shownName(
              getAfter(/databases/$(database)/documents/members/$(memberId)).data,
              'Member')
            || (resource != null
                && request.resource.data.get('name', null) == resource.data.get('name', null))
          )
        );
        allow delete: if isOperator() || (isSelf(memberId) && cohortRunning(cohortId));
      }

      // --- Threads -------------------------------------------------------
      // `cohort` is the group thread. Every other thread id is a member uid:
      // that member's private thread with the coach.
      //
      // The match is nested on the thread rather than spelled out per
      // subcollection so `myThread()` is written once. It gates both the
      // messages and the typing markers, and two copies of a predicate that
      // decides who may read a private thread with their coach is two copies
      // to keep in step.
      match /threads/{threadId} {
        function myThread() {
          return threadId == 'cohort' || threadId == request.auth.uid;
        }

        function validThreadProjection() {
          return request.resource.data.keys().hasOnly([
              'threadId', 'cohortId', 'kind', 'memberUid', 'memberName',
              'cohortName', 'lastMessageText', 'lastMessageAt',
              'lastMessageAuthorUid', 'lastMessageAuthorName',
              'lastReadByAdminAt', 'unreadForAdmin', 'updatedAt',
              'updatedByUid', 'updatedByEmail'
            ])
            && request.resource.data.threadId == threadId
            && request.resource.data.cohortId == cohortId
            && request.resource.data.kind in ['group', 'direct']
            && (threadId == 'cohort'
              ? request.resource.data.kind == 'group'
                && request.resource.data.memberUid == null
              : request.resource.data.kind == 'direct'
                && request.resource.data.memberUid == threadId)
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedByUid == request.auth.uid
            && request.resource.data.updatedByEmail == request.auth.token.email;
        }

        allow read: if isOperator() || (inCohort(cohortId) && myThread());
        allow create, update: if isOperator() && validThreadProjection();
        allow delete: if false;

        match /messages/{messageId} {
          /**
           * Whether a reaction moves `reactors` and `reactedAt` the one way it
           * may: the caller's own entry and nobody else's.
           *
           * Joining — no entry before, one after — is the only move that dates
           * the message, and it has to be made under the member's own name and
           * at `request.time`, since the entry is what the author's inbox
           * reads out ("Tomi reacted to your message") and a name or a time the
           * caller chose would be words put in someone else's mouth. Leaving
           * deletes the entry and dates nothing. Every other reaction touches
           * neither field, which is also what a build from before they existed
           * sends. The author never joins their own message.
           *
           * Keyed by uid so this is one map diff rather than a walk over a list,
           * which rules cannot do.
           */
          function movesOnlyOwnReactor() {
            let uid = request.auth.uid;
            let before = resource.data.get('reactors', {});
            let after = request.resource.data.get('reactors', {});
            let joined = !(uid in before) && uid in after;
            return after is map
              && after.diff(before).affectedKeys().hasOnly([uid])
              && (joined
                ? uid != resource.data.authorUid
                  && after[uid] == {'name': shownName(me(), 'Someone'), 'at': request.time}
                  && request.resource.data.reactedAt == request.time
                : request.resource.data.get('reactedAt', null) == resource.data.get('reactedAt', null)
                  && (!(uid in after) || after[uid] == before[uid]));
          }

          allow read: if isOperator() || (inCohort(cohortId) && myThread());

          allow create: if (
            isOperator()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.text is string
            && (request.resource.data.text.size() > 0
                || ('attachments' in request.resource.data
                    && request.resource.data.attachments is list
                    && request.resource.data.attachments.size() > 0))
            && request.resource.data.sentAt is timestamp
            && request.resource.data.isCoach == true
            && request.resource.data.reactionCounts.size() == 0
            && !('reactors' in request.resource.data)
            && !('reactedAt' in request.resource.data)
            && (!('addressedUids' in request.resource.data)
                || request.resource.data.addressedUids is list)
          ) || (
            inCohort(cohortId)
            && myThread()
            && cohortRunning(cohortId)
            && request.resource.data.authorUid == request.auth.uid
            // Posted under the member's own name. The edit rule below never lets
            // `authorName` move, so this is the only check it needs.
            && request.resource.data.authorName == shownName(me(), 'You')
            // Only the coach's messages get the coach's styling.
            && request.resource.data.isCoach == false
            // A new message starts with no reactions. Counts are only ever
            // moved by the increment below, and who reacted only ever by
            // `movesOnlyOwnReactor`.
            && request.resource.data.reactionCounts.size() == 0
            && !('reactors' in request.resource.data)
            && !('reactedAt' in request.resource.data)
            // Who it is aimed at, which is what puts it in their inbox. A list
            // when present; absent is still accepted, because a phone on a
            // build from before the field existed is still sending messages.
            //
            // Nothing here can check it against `mentions` and `replyTo` —
            // rules have no way to map over a list — so a member could reach
            // somebody without writing their name. That is no more than an
            // `@` already lets them do, and it reaches only their own cohort:
            // nobody else's inbox queries this thread.
            && (!('addressedUids' in request.resource.data)
                || request.resource.data.addressedUids is list)
          );

          // Two writes may touch a sent message, and nothing else may.
          //
          // The first is a reaction: the tally, moved one emoji at a time by
          // anyone who can read the thread, and with it the caller's own entry
          // in who reacted — see `movesOnlyOwnReactor`.
          //
          // The second is the author correcting their own words, for fifteen
          // minutes and then never again — the window in `EDIT_WINDOW_MS`,
          // enforced here because a limit the client alone applies is a limit
          // anyone with the SDK can ignore. `hasOnly` on the four fields an
          // edit owns — the words, when they changed, who they name and so who
          // they reach — is what keeps an "edit" from being something else
          // wearing its name: an update free to move `sentAt` could re-date a
          // message back into a window it has left, one free to move
          // `authorUid` could hand it to somebody else, and one free to move
          // `reactionCounts` could invent applause. `editedAt` must be `request.time` rather than a value the
          // caller chose, because "Edited" is a claim about *when*, and the
          // caller is the only party with a reason to misstate it.
          //
          // The coach's exemption is the one already here: coach tooling runs
          // on the Admin SDK, which bypasses all of this anyway.
          allow update: if isOperator() || (
            inCohort(cohortId) && myThread() && cohortRunning(cohortId)
            && (
              (changed().hasOnly(['reactionCounts', 'reactors', 'reactedAt'])
                && movesOnlyOwnReactor())
              || (
                changed().hasOnly(['text', 'editedAt', 'mentions', 'addressedUids'])
                && resource.data.authorUid == request.auth.uid
                && request.resource.data.editedAt == request.time
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.mentions is list
                && (!('addressedUids' in request.resource.data)
                    || request.resource.data.addressedUids is list)
                && request.time < resource.data.sentAt + duration.value(15, 'm')
              )
            )
          );

          allow delete: if isOperator() || (
            inCohort(cohortId) && cohortRunning(cohortId)
            && resource.data.authorUid == request.auth.uid
          );

          // Who reacted, one document per reactor, keyed by uid so a member can
          // only ever move their own.
          match /reactions/{reactorId} {
            allow read: if isOperator() || inCohort(cohortId);
            allow write: if isSelf(reactorId) && inCohort(cohortId) && cohortRunning(cohortId);
          }
        }

        // Who has the composer open, one document per person, keyed by uid.
        //
        // The two fields are the whole point of the restriction: a marker that
        // could carry arbitrary data would be a second, unmoderated way to put
        // text in front of the cohort, written to a path nothing renders as a
        // message and nobody would think to look at.
        match /typing/{typistId} {
          allow read: if isOperator() || (inCohort(cohortId) && myThread());

          // Split from delete for the reason the leaderboard block is split:
          // on a delete `request.resource` is null, so a `keys()` check on it
          // errors and denies — which would leave a member unable to say they
          // had stopped typing.
          allow create, update: if isOperator() || (
            isSelf(typistId)
            && inCohort(cohortId)
            && myThread()
            && cohortRunning(cohortId)
            && request.resource.data.keys().hasOnly(['name', 'at'])
            && request.resource.data.name == shownName(me(), 'Someone')
          );

          // Not held to `cohortRunning`: clearing a marker written just before
          // the end is the one thread write worth letting through after it.
          allow delete: if isOperator() || (isSelf(typistId) && inCohort(cohortId));
        }
      }
    }

    // --- Members -----------------------------------------------------------
    function isValidMemberCreate(uid) {
      let code = getAfter(
        /databases/$(database)/documents/accessCodes/$(request.resource.data.accessCode)
      );
      return request.resource.data.status == 'onboarding'
        && request.resource.data.accessCode is string
        && request.resource.data.email == request.auth.token.email
        // Older/current PWA builds omit this field. When present it must be
        // truthful; when absent, `trustsSignIn()` still refuses a future
        // unverified linked-Google sign-in after the compatibility cutoff.
        && (!('joinedWith' in request.resource.data)
            || request.resource.data.joinedWith
                 == request.auth.token.firebase.sign_in_provider)
        && request.resource.data.stats.points == 0
        && request.resource.data.stats.sessionsQualified == 0
        // A region's floor is `setRegion`'s to stamp.
        && !('region' in request.resource.data)
        // Cohorts already finished are `joinCohort`'s to record.
        && !('previousCohorts' in request.resource.data)
        // The membership and claim are one transaction, including rebuilds
        // where the code was already claimed by this uid.
        && code.data.status == 'claimed'
        && code.data.claimedByUid == uid
        && request.resource.data.cohortId == code.data.cohortId
        && request.resource.data.cohortName == code.data.cohortName
        // New codes pin a program. Legacy codes may omit it; the PWA writes
        // the same empty/default snapshot and resolves the cohort program when
        // it first loads training content.
        && request.resource.data.programId == code.data.get('programId', '')
        && request.resource.data.programVersion
             == code.data.get('programVersion', 1);
    }

    function isValidMemberSelfUpdate() {
      return request.resource.data.get('email', null)
             == resource.data.get('email', null)
        && request.resource.data.get('joinedWith', null)
             == resource.data.get('joinedWith', null)
        && request.resource.data.cohortId == resource.data.cohortId
        && request.resource.data.get('cohortName', null)
             == resource.data.get('cohortName', null)
        && request.resource.data.accessCode == resource.data.accessCode
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.programId == resource.data.programId
        && request.resource.data.get('programVersion', null)
             == resource.data.get('programVersion', null)
        // Written only by `setRegion`, which stamps the floor that keeps a
        // region change forward-only.
        && request.resource.data.get('region', null)
             == resource.data.get('region', null)
        // Written only by `joinCohort`, as the member joins another cohort.
        && request.resource.data.get('previousCohorts', null)
             == resource.data.get('previousCohorts', null)
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'onboarding'
                && request.resource.data.status == 'active'))
        && request.resource.data.get('previousStatus', null)
             == resource.data.get('previousStatus', null)
        && request.resource.data.get('pauseReason', null)
             == resource.data.get('pauseReason', null)
        && request.resource.data.get('pausedAt', null)
             == resource.data.get('pausedAt', null)
        // Display name and height are setup answers and stay fixed afterwards.
        && (resource.data.status == 'onboarding' || (
          request.resource.data.get('profile', {}).get('displayName', null)
            == resource.data.get('profile', {}).get('displayName', null)
          && request.resource.data.get('profile', {}).get('heightCm', null)
            == resource.data.get('profile', {}).get('heightCm', null)
        ));
    }

    function isValidMemberPause() {
      return resource.data.status in ['onboarding', 'active']
        && changed().hasOnly([
          'status', 'previousStatus', 'pauseReason', 'pausedAt',
          'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.status == 'paused'
        && request.resource.data.previousStatus == resource.data.status
        && request.resource.data.pauseReason is string
        && request.resource.data.pauseReason.size() >= 3
        && request.resource.data.pauseReason.size() <= 240
        && request.resource.data.pausedAt == request.time
        && hasOperatorUpdateAudit();
    }

    function isValidMemberResume() {
      return resource.data.status == 'paused'
        && resource.data.previousStatus in ['onboarding', 'active']
        && changed().hasOnly([
          'status', 'previousStatus', 'pauseReason', 'pausedAt',
          'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.status == resource.data.previousStatus
        && request.resource.data.previousStatus == null
        && request.resource.data.pauseReason == null
        && request.resource.data.pausedAt == null
        && hasOperatorUpdateAudit();
    }

    function isValidLifecycleEvent(uid, eventId) {
      return request.resource.data.keys().hasOnly([
          'eventId', 'memberId', 'type', 'fromStatus', 'toStatus', 'reason',
          'createdAt', 'createdByUid', 'createdByEmail'
        ])
        && (!('eventId' in request.resource.data)
            || request.resource.data.eventId == eventId)
        && request.resource.data.memberId == uid
        && request.resource.data.type in [
          'member.joined', 'member.paused', 'member.resumed', 'member.completed'
        ]
        && (request.resource.data.fromStatus == null
            || request.resource.data.fromStatus in [
              'onboarding', 'active', 'paused', 'completed'
            ])
        && request.resource.data.toStatus in [
          'onboarding', 'active', 'paused', 'completed'
        ]
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 240
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;
    }

    function isValidSessionReview() {
      return changed().hasOnly([
          'reviewStatus', 'reviewNote', 'reviewedAt',
          'reviewedByUid', 'reviewedByEmail',
          'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.reviewStatus in [
          'approved', 'needs-attention', 'rejected'
        ]
        && request.resource.data.get('reviewNote', '') is string
        && request.resource.data.get('reviewNote', '').size() <= 500
        && request.resource.data.reviewedAt == request.time
        && hasOperatorUpdateAudit();
    }

    function isValidCheckInReview() {
      return changed().hasOnly([
          'reviewStatus', 'reviewNote', 'reviewedAt',
          'reviewedByUid', 'reviewedByEmail',
          'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.reviewStatus in ['reviewed', 'needs-attention']
        && request.resource.data.get('reviewNote', '') is string
        && request.resource.data.get('reviewNote', '').size() <= 500
        && request.resource.data.reviewedAt == request.time
        && hasOperatorUpdateAudit();
    }

    match /members/{uid} {
      // Operators can support members without gaining broad profile writes.
      allow read: if isSelf(uid) || isOperator();

      allow create: if isSelf(uid) && isValidMemberCreate(uid);

      // Nothing about a member moves once their cohort is over.
      allow update: if (isSelf(uid) && cohortRunning(resource.data.cohortId) && isValidMemberSelfUpdate())
        || (isOperator() && (isValidMemberPause() || isValidMemberResume()));

      // Erasure remains a server-side operation so Auth, Storage, projections,
      // and subcollections can be removed together.
      allow delete: if false;

      // Operators may inspect activity for support. Only the member writes it.
      // Check-ins and lifecycle history have stricter append-only blocks below.
      // Sessions, check-ins and photos are filed on a day or a week, and the
      // day is the server's: the functions in `apps/functions` write them, so
      // no member writes them here.
      //
      // All of it closes with the cohort, but for one delete: releasing a push
      // device is sign-out tidying up after itself, and refusing it would only
      // leave a token behind to push an ended app to.
      match /{collection}/{docId} {
        allow read: if isOperator()
          || (isSelf(uid)
              && collection != 'checkIns'
              && collection != 'lifecycleEvents');
        allow create, update: if isSelf(uid)
          && !(collection in ['checkIns', 'lifecycleEvents', 'sessions', 'photos'])
          && cohortRunning(me().cohortId);
        allow delete: if isSelf(uid)
          && !(collection in ['checkIns', 'lifecycleEvents', 'sessions', 'photos'])
          && (collection == 'pushDevices' || cohortRunning(me().cohortId));
      }

      // A week's check-in is create-once and immutable. `submitCheckIn` creates it.
      match /checkIns/{weekId} {
        allow read: if isSelf(uid) || isOperator();
        allow update: if isOperator() && isValidCheckInReview();
        allow delete: if false;
      }

      // `logSession` creates it; a logged session stays logged.
      match /sessions/{sessionId} {
        allow read: if isSelf(uid) || isOperator();
        allow update: if isOperator() && isValidSessionReview();
        allow delete: if false;
      }

      // `logPhoto` files it; the member may still take their own image back.
      match /photos/{photoId} {
        allow delete: if isSelf(uid) && cohortRunning(me().cohortId);
      }

      // Status history is append-only for both member and operator.
      match /lifecycleEvents/{eventId} {
        allow read: if isSelf(uid) || isOperator();
        allow create: if ((isSelf(uid) && cohortRunning(me().cohortId)) || isOperator())
          && isValidLifecycleEvent(uid, eventId);
        allow update, delete: if false;
      }
    }
  }
}
