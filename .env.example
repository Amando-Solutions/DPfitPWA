# ---------------------------------------------------------------------------
# DP Fitness PWA environment
# Copy to `.env` (git-ignored) and adjust. Everything here is PUBLIC config:
# it is bundled into the client, so never put secrets in NUXT_PUBLIC_* vars.
# ---------------------------------------------------------------------------

# Serve every screen from the fixtures in `data/*.ts`.
# true  → mock data (default; works with no backend running)
# false → read from NUXT_PUBLIC_API_BASE
NUXT_PUBLIC_USE_MOCK_DATA=true

# Backend origin, used only when NUXT_PUBLIC_USE_MOCK_DATA=false.
# If this is empty the app falls back to mock data and logs a warning.
NUXT_PUBLIC_API_BASE=

# Free-form label for the running environment (development | staging | production).
NUXT_PUBLIC_APP_ENV=development
