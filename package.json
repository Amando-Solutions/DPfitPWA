{
  "name": "dp-fitness",
  "private": true,
  "type": "module",
  "description": "DP Fitness monorepo · the member PWA, the public landing site, and the design system they share",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun run --filter dp-fitness-web dev",
    "dev:pwa": "bun run --filter dp-fitness-pwa dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --filter dp-fitness-web build",
    "build:pwa": "bun run --filter dp-fitness-pwa build",
    "typecheck": "bun run --filter '*' typecheck",
    "postinstall": "bun run --filter '*' postinstall",
    "backfill:codes": "bun run --filter dp-fitness-pwa backfill:codes",
    "rules:diff": "diff firestore.rules firestore.staging.rules && echo '✓ staging rules are identical to production' || echo '↑ staging has diverged from production'",
    "deploy:staging": "firebase deploy --only firestore:staging",
    "deploy:rules": "firebase deploy --only firestore,storage"
  },
  "devDependencies": {
    "firebase-tools": "^15.28.2",
    "typescript": "^5.9.0"
  }
}
