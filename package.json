{
  "name": "dp-fitness",
  "private": true,
  "type": "module",
  "description": "DP Fitness monorepo · the member PWA, the public landing site, the admin console, their Cloud Functions, and the design system the first two share",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun run --filter dp-fitness-web dev",
    "dev:pwa": "bun run --filter dp-fitness-pwa dev",
    "dev:admin": "bun run --filter dp-fitness-admin dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --filter dp-fitness-web build",
    "build:pwa": "bun run --filter dp-fitness-pwa build",
    "build:admin": "bun run --filter dp-fitness-admin build",
    "build:functions": "bun run --filter dp-fitness-functions build",
    "typecheck": "bun run --filter '*' typecheck",
    "brand:assets": "bun run --filter @dpfit/theme brand:assets",
    "postinstall": "bun run --filter '*' postinstall",
    "backfill:codes": "bun run --filter dp-fitness-pwa backfill:codes",
    "rules:diff": "diff firestore.rules firestore.staging.rules && echo '✓ staging rules are identical to production' || echo '↑ staging has diverged from production'",
    "deploy:staging": "firebase deploy --only firestore:staging",
    "deploy:rules": "firebase deploy --only firestore,storage",
    "deploy:functions": "firebase deploy --only functions"
  },
  "devDependencies": {
    "firebase-tools": "^15.28.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
